# Generated case JSON fixtures (the .ts source-of-truth IS committed)
data/cases/*.json

# Keep policy markdown extracts in the repo — NIRA needs them at runtime
# data/policies/*.md  ← intentionally NOT ignored

# Heavy source PDFs are NOT needed at runtime; keep them out of git to avoid
# repo bloat (~67 MB). Re-generate the markdown extracts with
# `npm run extract-policies` when source PDFs change.
docs/payer_docs/_archives/
docs/payer_docs/_flat/
docs/payer_docs/**/*.pdf
docs/**/*.docx
docs/**/*.xlsx

