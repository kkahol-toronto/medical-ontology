# =============================================================================
# Agentic RCM Demo — environment configuration
# Copy this file to .env (never commit real .env) and fill in real values.
# =============================================================================

# --- AWS (Bedrock + Comprehend Medical) -------------------------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=000000000000

# Bedrock model used by the hero appeal letter and denial root-cause agent.
# Use the eu cross-region inference profile for capacity headroom in EU.
BEDROCK_MODEL_ID=anthropic.claude-opus-4-7
# BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-7

# Toggles whether the CDI/Coding agents call AWS Comprehend Medical.
ENABLE_COMPREHEND_MEDICAL=true

# --- Azure Voice Live (gpt-realtime) ----------------------------------------
# AI Foundry project URL — host portion is reused to build the WSS URL.
AZURE_VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_VOICE_LIVE_KEY=...
AZURE_VOICE_LIVE_API_VERSION=2025-10-01
AZURE_VOICE_LIVE_MODEL=gpt-realtime
